# ==============================================================================
# NI-OH STRATEGIC AUTONOMOUS COMPANION - CONFIGURATION TEMPLATE
# ==============================================================================

# 1. DISCORD BOT TOKEN (BẮT BUỘC để bot online trên Discord)
# Lấy miễn phí tại: https://discord.com/developers/applications
# Tạo App -> Menu Bot -> Reset Token -> Copy dán vào đây
# Nhớ BẬT cả 3 mục: Presence Intent, Server Members Intent, Message Content Intent
DISCORD_TOKEN=your_discord_bot_token_here

# 2. DISCORD OWNER ID (ID tài khoản Discord của bạn để Bot nhận diện chủ nhân)
# Bật Developer Mode trên Discord -> Chuột phải vào tên bạn -> Copy User ID
OWNER_DISCORD_ID=your_discord_user_id_here

# 3. GOOGLE GEMINI API KEY (Dành cho chế độ Cloud AI - Hoàn toàn MIỄN PHÍ)
# Lấy tại: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# 4. CỔNG SUY LUẬN AI (Tùy chọn: local / antigravity / openai / claude)
# Mặc định: local (nếu có Ollama) hoặc antigravity/gemini
AI_PROVIDER=local

# 5. OLLAMA LOCAL MODEL (Chạy Offline 0-Token trên card đồ họa máy tính)
# Model văn bản tiếng Việt: qwen2.5:7b hoặc qwen-vi:latest
LOCAL_LLM_MODEL=qwen2.5:7b
# Model thị giác quét màn hình: moondream:latest
LOCAL_VLM_MODEL=moondream:latest

# 6. GIỌNG ĐỌC VOICE AGENT (Edge-TTS miễn phí 100% / Kokoro / Piper)
# Gợi ý: vi-VN-HoaiMyNeural (Nữ), vi-VN-NamMinhNeural (Nam), en-US-JennyNeural
VOICE_NAME=vi-VN-NamMinhNeural
