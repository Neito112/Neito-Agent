# Cong may chu Neito Brain Server (Mac dinh: 4242)
BRAIN_PORT=4242

# GitHub Personal Access Token (Tuy chon, dung de tang gioi han API rate limit khi tim kiem repo)
GITHUB_TOKEN=

# Model API Keys (Tuy chon neu ban muon tich hop nha cung cap LLM ben ngoai)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
