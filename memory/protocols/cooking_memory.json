    {
      "type": "update",
      "topic": "Cooking & Food",
      "content": "Knife skills: Grip correctly, blade angle 15-20 degrees, cut away from body. Use chef knife for 90% of kitchen tasks. Keep knife sharp — dull knife is more dangerous than sharp knife due to higher force needed.",
      "source": "cooking_protocol",
      "lang": "en",
